~[tlist_sql;
	WITH base AS (
		SELECT
			u_cdol_staff_changes.id,
			u_cdol_staff_changes.final_completion_date,
			u_cdol_staff_changes.ps_created,
			u_cdol_staff_changes.ad_created,
			u_cdol_staff_changes.ad_ignored,
			u_cdol_staff_changes.o365_created,
			u_cdol_staff_changes.o365_ignored,
			u_cdol_staff_changes.lms_created,
			u_cdol_staff_changes.lms_ignored,
			u_cdol_staff_changes.canva_created,
			u_cdol_staff_changes.canva_ignored,
			u_cdol_staff_changes.change_type
		FROM
			u_cdol_staff_changes
		WHERE
			(u_cdol_staff_changes.calendar_year = ~(gpv.calendarYear;num) OR ~(gpv.calendarYear;num) = 0)
			AND (u_cdol_staff_changes.schoolid = ~(gpv.curSchoolID;num) OR ~(gpv.curSchoolID;num) = 0)
	),
	metrics AS (
		SELECT
			COUNT(id) AS total_submissions,
			COUNT(CASE WHEN final_completion_date IS NOT NULL THEN id END) AS total_complete,
			COUNT(id) - COUNT(CASE WHEN final_completion_date IS NOT NULL THEN id END) AS total_remaining,
			COUNT(CASE WHEN ps_created = 1 AND final_completion_date IS NOT NULL THEN id END) AS total_ps_complete,
			COUNT(id) - COUNT(CASE WHEN ps_created = 1 AND final_completion_date IS NOT NULL THEN id END) AS total_ps_remaining,
			COUNT(CASE WHEN ad_created = 1 OR ad_ignored = 1 THEN id END) AS total_ad_complete,
			COUNT(id) - COUNT(CASE WHEN ad_created = 1 OR ad_ignored = 1 THEN id END) AS total_ad_remaining,
			COUNT(CASE WHEN o365_created = 1 OR o365_ignored = 1 THEN id END) AS total_o365_complete,
			COUNT(id) - COUNT(CASE WHEN o365_created = 1 OR o365_ignored = 1 THEN id END) AS total_o365_remaining,
			COUNT(CASE WHEN lms_created = 1 OR lms_ignored = 1 THEN id END) AS total_lms_complete,
			COUNT(id) - COUNT(CASE WHEN lms_created = 1 OR lms_ignored = 1 THEN id END) AS total_lms_remaining,
			COUNT(CASE WHEN canva_created = 1 OR canva_ignored = 1 THEN id END) AS total_canva_complete,
			COUNT(id) - COUNT(CASE WHEN canva_created = 1 OR canva_ignored = 1 THEN id END) AS total_canva_remaining,

			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) AS total_new_submissions,
			COUNT(CASE WHEN change_type = 'newStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_new_complete,
			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) - COUNT(CASE WHEN change_type = 'newStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_new_remaining,
			COUNT(CASE WHEN change_type = 'newStaff' AND ps_created = 1 THEN id END) AS total_new_ps_complete,
			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) - COUNT(CASE WHEN change_type = 'newStaff' AND ps_created = 1 THEN id END) AS total_new_ps_remaining,
			COUNT(CASE WHEN change_type = 'newStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_new_ad_complete,
			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) - COUNT(CASE WHEN change_type = 'newStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_new_ad_remaining,
			COUNT(CASE WHEN change_type = 'newStaff' AND (o365_created = 1 OR o365_ignored = 1) THEN id END) AS total_new_o365_complete,
			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) - COUNT(CASE WHEN change_type = 'newStaff' AND (o365_created = 1 OR o365_ignored = 1) THEN id END) AS total_new_o365_remaining,
			COUNT(CASE WHEN change_type = 'newStaff' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_new_lms_complete,
			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) - COUNT(CASE WHEN change_type = 'newStaff' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_new_lms_remaining,
			COUNT(CASE WHEN change_type = 'newStaff' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_new_canva_complete,
			COUNT(CASE WHEN change_type = 'newStaff' THEN id END) - COUNT(CASE WHEN change_type = 'newStaff' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_new_canva_remaining,

			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) AS total_transfer_submissions,
			COUNT(CASE WHEN change_type = 'transferringStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_transfer_complete,
			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) - COUNT(CASE WHEN change_type = 'transferringStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_transfer_remaining,
			COUNT(CASE WHEN change_type = 'transferringStaff' AND ps_created = 1 THEN id END) AS total_transfer_ps_complete,
			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) - COUNT(CASE WHEN change_type = 'transferringStaff' AND ps_created = 1 THEN id END) AS total_transfer_ps_remaining,
			COUNT(CASE WHEN change_type = 'transferringStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_transfer_ad_complete,
			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) - COUNT(CASE WHEN change_type = 'transferringStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_transfer_ad_remaining,
			COUNT(CASE WHEN change_type = 'transferringStaff' AND (o365_created = 1 OR o365_ignored = 1) THEN id END) AS total_transfer_o365_complete,
			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) - COUNT(CASE WHEN change_type = 'transferringStaff' AND (o365_created = 1 OR o365_ignored = 1) THEN id END) AS total_transfer_o365_remaining,
			COUNT(CASE WHEN change_type = 'transferringStaff' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_transfer_lms_complete,
			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) - COUNT(CASE WHEN change_type = 'transferringStaff' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_transfer_lms_remaining,
			COUNT(CASE WHEN change_type = 'transferringStaff' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_transfer_canva_complete,
			COUNT(CASE WHEN change_type = 'transferringStaff' THEN id END) - COUNT(CASE WHEN change_type = 'transferringStaff' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_transfer_canva_remaining,

			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) AS total_name_change_submissions,
			COUNT(CASE WHEN change_type = 'nameChange' AND final_completion_date IS NOT NULL THEN id END) AS total_name_change_complete,
			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) - COUNT(CASE WHEN change_type = 'nameChange' AND final_completion_date IS NOT NULL THEN id END) AS total_name_change_remaining,
			COUNT(CASE WHEN change_type = 'nameChange' AND ps_created = 1 THEN id END) AS total_name_change_ps_complete,
			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) - COUNT(CASE WHEN change_type = 'nameChange' AND ps_created = 1 THEN id END) AS total_name_change_ps_remaining,
			COUNT(CASE WHEN change_type = 'nameChange' AND ad_created = 1 THEN id END) AS total_name_change_ad_complete,
			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) - COUNT(CASE WHEN change_type = 'nameChange' AND ad_created = 1 THEN id END) AS total_name_change_ad_remaining,
			COUNT(CASE WHEN change_type = 'nameChange' AND o365_created = 1 THEN id END) AS total_name_change_o365_complete,
			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) - COUNT(CASE WHEN change_type = 'nameChange' AND o365_created = 1 THEN id END) AS total_name_change_o365_remaining,
			COUNT(CASE WHEN change_type = 'nameChange' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_name_change_lms_complete,
			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) - COUNT(CASE WHEN change_type = 'nameChange' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_name_change_lms_remaining,
			COUNT(CASE WHEN change_type = 'nameChange' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_name_change_canva_complete,
			COUNT(CASE WHEN change_type = 'nameChange' THEN id END) - COUNT(CASE WHEN change_type = 'nameChange' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_name_change_canva_remaining,

			COUNT(CASE WHEN change_type = 'jobChange' THEN id END) AS total_job_change_submissions,
			COUNT(CASE WHEN change_type = 'jobChange' AND final_completion_date IS NOT NULL THEN id END) AS total_job_change_complete,
			COUNT(CASE WHEN change_type = 'jobChange' THEN id END) - COUNT(CASE WHEN change_type = 'jobChange' AND final_completion_date IS NOT NULL THEN id END) AS total_job_change_remaining,
			COUNT(CASE WHEN change_type = 'jobChange' AND ps_created = 1 THEN id END) AS total_job_change_ps_complete,
			COUNT(CASE WHEN change_type = 'jobChange' THEN id END) - COUNT(CASE WHEN change_type = 'jobChange' AND ps_created = 1 THEN id END) AS total_job_change_ps_remaining,
			COUNT(CASE WHEN change_type = 'jobChange' AND ad_created = 1 THEN id END) AS total_job_change_ad_complete,
			COUNT(CASE WHEN change_type = 'jobChange' THEN id END) - COUNT(CASE WHEN change_type = 'jobChange' AND ad_created = 1 THEN id END) AS total_job_change_ad_remaining,

			COUNT(CASE WHEN change_type = 'exitingStaff' THEN id END) AS total_exit_submissions,
			COUNT(CASE WHEN change_type = 'exitingStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_exit_complete,
			COUNT(CASE WHEN change_type = 'exitingStaff' THEN id END) - COUNT(CASE WHEN change_type = 'exitingStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_exit_remaining,
			COUNT(CASE WHEN change_type = 'exitingStaff' AND ps_created = 1 THEN id END) AS total_exit_ps_complete,
			COUNT(CASE WHEN change_type = 'exitingStaff' THEN id END) - COUNT(CASE WHEN change_type = 'exitingStaff' AND ps_created = 1 THEN id END) AS total_exit_ps_remaining,
			COUNT(CASE WHEN change_type = 'exitingStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_exit_ad_complete,
			COUNT(CASE WHEN change_type = 'exitingStaff' THEN id END) - COUNT(CASE WHEN change_type = 'exitingStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_exit_ad_remaining,
			COUNT(CASE WHEN change_type = 'exitingStaff' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_exit_canva_complete,
			COUNT(CASE WHEN change_type = 'exitingStaff' THEN id END) - COUNT(CASE WHEN change_type = 'exitingStaff' AND (canva_created = 1 OR canva_ignored = 1) THEN id END) AS total_exit_canva_remaining,

			COUNT(CASE WHEN change_type = 'subStaff' THEN id END) AS total_sub_submissions,
			COUNT(CASE WHEN change_type = 'subStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_sub_complete,
			COUNT(CASE WHEN change_type = 'subStaff' THEN id END) - COUNT(CASE WHEN change_type = 'subStaff' AND final_completion_date IS NOT NULL THEN id END) AS total_sub_remaining,
			COUNT(CASE WHEN change_type = 'subStaff' AND ps_created = 1 THEN id END) AS total_sub_ps_complete,
			COUNT(CASE WHEN change_type = 'subStaff' THEN id END) - COUNT(CASE WHEN change_type = 'subStaff' AND ps_created = 1 THEN id END) AS total_sub_ps_remaining,
			COUNT(CASE WHEN change_type = 'subStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_sub_ad_complete,
			COUNT(CASE WHEN change_type = 'subStaff' THEN id END) - COUNT(CASE WHEN change_type = 'subStaff' AND (ad_created = 1 OR ad_ignored = 1) THEN id END) AS total_sub_ad_remaining,
			COUNT(CASE WHEN change_type = 'subStaff' AND (o365_created = 1 OR o365_ignored = 1) THEN id END) AS total_sub_o365_complete,
			COUNT(CASE WHEN change_type = 'subStaff' THEN id END) - COUNT(CASE WHEN change_type = 'subStaff' AND (o365_created = 1 OR o365_ignored = 1) THEN id END) AS total_sub_o365_remaining,
			COUNT(CASE WHEN change_type = 'subStaff' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_sub_lms_complete,
			COUNT(CASE WHEN change_type = 'subStaff' THEN id END) - COUNT(CASE WHEN change_type = 'subStaff' AND (lms_created = 1 OR lms_ignored = 1) THEN id END) AS total_sub_lms_remaining
		FROM
			base
	)
	SELECT
		COALESCE(
			JSON_ARRAYAGG(
				JSON_OBJECT(
					'total_submissions' VALUE TO_CHAR(total_submissions),
					'total_complete' VALUE TO_CHAR(total_complete),
					'total_remaining' VALUE TO_CHAR(total_remaining),
					'total_ps_complete' VALUE TO_CHAR(total_ps_complete),
					'total_ps_remaining' VALUE TO_CHAR(total_ps_remaining),
					'total_ad_complete' VALUE TO_CHAR(total_ad_complete),
					'total_ad_remaining' VALUE TO_CHAR(total_ad_remaining),
					'total_o365_complete' VALUE TO_CHAR(total_o365_complete),
					'total_o365_remaining' VALUE TO_CHAR(total_o365_remaining),
					'total_lms_complete' VALUE TO_CHAR(total_lms_complete),
					'total_lms_remaining' VALUE TO_CHAR(total_lms_remaining),
					'total_canva_complete' VALUE TO_CHAR(total_canva_complete),
					'total_canva_remaining' VALUE TO_CHAR(total_canva_remaining),
					'total_new_submissions' VALUE TO_CHAR(total_new_submissions),
					'total_new_complete' VALUE TO_CHAR(total_new_complete),
					'total_new_remaining' VALUE TO_CHAR(total_new_remaining),
					'total_new_ps_complete' VALUE TO_CHAR(total_new_ps_complete),
					'total_new_ps_remaining' VALUE TO_CHAR(total_new_ps_remaining),
					'total_new_ad_complete' VALUE TO_CHAR(total_new_ad_complete),
					'total_new_ad_remaining' VALUE TO_CHAR(total_new_ad_remaining),
					'total_new_o365_complete' VALUE TO_CHAR(total_new_o365_complete),
					'total_new_o365_remaining' VALUE TO_CHAR(total_new_o365_remaining),
					'total_new_lms_complete' VALUE TO_CHAR(total_new_lms_complete),
					'total_new_lms_remaining' VALUE TO_CHAR(total_new_lms_remaining),
					'total_new_canva_complete' VALUE TO_CHAR(total_new_canva_complete),
					'total_new_canva_remaining' VALUE TO_CHAR(total_new_canva_remaining),
					'total_transfer_submissions' VALUE TO_CHAR(total_transfer_submissions),
					'total_transfer_complete' VALUE TO_CHAR(total_transfer_complete),
					'total_transfer_remaining' VALUE TO_CHAR(total_transfer_remaining),
					'total_transfer_ps_complete' VALUE TO_CHAR(total_transfer_ps_complete),
					'total_transfer_ps_remaining' VALUE TO_CHAR(total_transfer_ps_remaining),
					'total_transfer_ad_complete' VALUE TO_CHAR(total_transfer_ad_complete),
					'total_transfer_ad_remaining' VALUE TO_CHAR(total_transfer_ad_remaining),
					'total_transfer_o365_complete' VALUE TO_CHAR(total_transfer_o365_complete),
					'total_transfer_o365_remaining' VALUE TO_CHAR(total_transfer_o365_remaining),
					'total_transfer_lms_complete' VALUE TO_CHAR(total_transfer_lms_complete),
					'total_transfer_lms_remaining' VALUE TO_CHAR(total_transfer_lms_remaining),
					'total_transfer_canva_complete' VALUE TO_CHAR(total_transfer_canva_complete),
					'total_transfer_canva_remaining' VALUE TO_CHAR(total_transfer_canva_remaining),
					'total_name_change_submissions' VALUE TO_CHAR(total_name_change_submissions),
					'total_name_change_complete' VALUE TO_CHAR(total_name_change_complete),
					'total_name_change_remaining' VALUE TO_CHAR(total_name_change_remaining),
					'total_name_change_ps_complete' VALUE TO_CHAR(total_name_change_ps_complete),
					'total_name_change_ps_remaining' VALUE TO_CHAR(total_name_change_ps_remaining),
					'total_name_change_ad_complete' VALUE TO_CHAR(total_name_change_ad_complete),
					'total_name_change_ad_remaining' VALUE TO_CHAR(total_name_change_ad_remaining),
					'total_name_change_o365_complete' VALUE TO_CHAR(total_name_change_o365_complete),
					'total_name_change_o365_remaining' VALUE TO_CHAR(total_name_change_o365_remaining),
					'total_name_change_lms_complete' VALUE TO_CHAR(total_name_change_lms_complete),
					'total_name_change_lms_remaining' VALUE TO_CHAR(total_name_change_lms_remaining),
					'total_name_change_canva_complete' VALUE TO_CHAR(total_name_change_canva_complete),
					'total_name_change_canva_remaining' VALUE TO_CHAR(total_name_change_canva_remaining),
					'total_job_change_submissions' VALUE TO_CHAR(total_job_change_submissions),
					'total_job_change_complete' VALUE TO_CHAR(total_job_change_complete),
					'total_job_change_remaining' VALUE TO_CHAR(total_job_change_remaining),
					'total_job_change_ps_complete' VALUE TO_CHAR(total_job_change_ps_complete),
					'total_job_change_ps_remaining' VALUE TO_CHAR(total_job_change_ps_remaining),
					'total_job_change_ad_complete' VALUE TO_CHAR(total_job_change_ad_complete),
					'total_job_change_ad_remaining' VALUE TO_CHAR(total_job_change_ad_remaining),
					'total_exit_submissions' VALUE TO_CHAR(total_exit_submissions),
					'total_exit_complete' VALUE TO_CHAR(total_exit_complete),
					'total_exit_remaining' VALUE TO_CHAR(total_exit_remaining),
					'total_exit_ps_complete' VALUE TO_CHAR(total_exit_ps_complete),
					'total_exit_ps_remaining' VALUE TO_CHAR(total_exit_ps_remaining),
					'total_exit_ad_complete' VALUE TO_CHAR(total_exit_ad_complete),
					'total_exit_ad_remaining' VALUE TO_CHAR(total_exit_ad_remaining),
					'total_exit_canva_complete' VALUE TO_CHAR(total_exit_canva_complete),
					'total_exit_canva_remaining' VALUE TO_CHAR(total_exit_canva_remaining),
					'total_sub_submissions' VALUE TO_CHAR(total_sub_submissions),
					'total_sub_complete' VALUE TO_CHAR(total_sub_complete),
					'total_sub_remaining' VALUE TO_CHAR(total_sub_remaining),
					'total_sub_ps_complete' VALUE TO_CHAR(total_sub_ps_complete),
					'total_sub_ps_remaining' VALUE TO_CHAR(total_sub_ps_remaining),
					'total_sub_ad_complete' VALUE TO_CHAR(total_sub_ad_complete),
					'total_sub_ad_remaining' VALUE TO_CHAR(total_sub_ad_remaining),
					'total_sub_o365_complete' VALUE TO_CHAR(total_sub_o365_complete),
					'total_sub_o365_remaining' VALUE TO_CHAR(total_sub_o365_remaining),
					'total_sub_lms_complete' VALUE TO_CHAR(total_sub_lms_complete),
					'total_sub_lms_remaining' VALUE TO_CHAR(total_sub_lms_remaining)
					RETURNING CLOB
				)
				RETURNING CLOB
			),
			TO_CLOB('[]')
		)
	FROM
		metrics
;]~(data)[/tlist_sql]
