~[tlist_sql;
	WITH metrics AS (
		SELECT
			COUNT(u_cdol_staff_changes.id) AS total_remaining,
			COUNT(CASE WHEN u_cdol_staff_changes.change_type = 'newStaff' THEN u_cdol_staff_changes.id END) AS total_new_remaining,
			COUNT(CASE WHEN u_cdol_staff_changes.change_type = 'transferringStaff' THEN u_cdol_staff_changes.id END) AS total_transfer_remaining,
			COUNT(CASE WHEN u_cdol_staff_changes.change_type = 'jobChange' THEN u_cdol_staff_changes.id END) AS total_job_change_remaining,
			COUNT(CASE WHEN u_cdol_staff_changes.change_type = 'subStaff' THEN u_cdol_staff_changes.id END) AS total_sub_remaining,
			COUNT(CASE WHEN u_cdol_staff_changes.change_type = 'nameChange' THEN u_cdol_staff_changes.id END) AS total_name_change_remaining,
			COUNT(CASE WHEN u_cdol_staff_changes.change_type = 'exitingStaff' THEN u_cdol_staff_changes.id END) AS total_exit_remaining
		FROM
			u_cdol_staff_changes
		WHERE
			u_cdol_staff_changes.final_completion_date IS NULL
			AND (u_cdol_staff_changes.calendar_year = ~(gpv.calendarYear;num) OR ~(gpv.calendarYear;num) = 0)
			AND (u_cdol_staff_changes.schoolid = ~(gpv.curSchoolID;num) OR ~(gpv.curSchoolID;num) = 0)
	)
	SELECT
		COALESCE(
			JSON_ARRAYAGG(
				JSON_OBJECT(
					'total_remaining' VALUE TO_CHAR(metrics.total_remaining),
					'total_new_remaining' VALUE TO_CHAR(metrics.total_new_remaining),
					'total_transfer_remaining' VALUE TO_CHAR(metrics.total_transfer_remaining),
					'total_job_change_remaining' VALUE TO_CHAR(metrics.total_job_change_remaining),
					'total_sub_remaining' VALUE TO_CHAR(metrics.total_sub_remaining),
					'total_name_change_remaining' VALUE TO_CHAR(metrics.total_name_change_remaining),
					'total_exit_remaining' VALUE TO_CHAR(metrics.total_exit_remaining)
					RETURNING CLOB
				)
				RETURNING CLOB
			),
			TO_CLOB('[]')
		)
	FROM
		metrics
;]~(data)[/tlist_sql]
