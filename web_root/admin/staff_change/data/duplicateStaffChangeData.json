~[tlist_sql;
	SELECT
		COALESCE(
			JSON_ARRAYAGG(
				JSON_OBJECT(
					'staffid' VALUE TO_CHAR(sc.id),
					'change_type' VALUE sc.change_type,
					'title' VALUE sc.title,
					'first_name' VALUE sc.first_name,
					'last_name' VALUE sc.last_name,
					'submittedstaff' VALUE users_submitted.first_name || ' ' || users_submitted.last_name,
					'submission_date' VALUE TO_CHAR(sc.submission_date, 'MM/DD/YYYY'),
					'submission_time' VALUE sc.submission_time,
					'schname' VALUE CASE
						WHEN sc.schoolid = 0 THEN 'Diocesan Office'
						ELSE schools.name
					END,
					'schoolid' VALUE TO_CHAR(sc.schoolid)
					RETURNING CLOB
				)
				ORDER BY sc.submission_date DESC, sc.last_name
				RETURNING CLOB
			),
			TO_CLOB('[]')
		)
	FROM
		u_cdol_staff_changes sc
		LEFT OUTER JOIN schools
			ON sc.schoolid = schools.school_number
		LEFT OUTER JOIN users users_submitted
			ON sc.who_submitted = users_submitted.dcid
	WHERE
		UTL_MATCH.JARO_WINKLER_SIMILARITY(UPPER(sc.first_name), UPPER('~(gpv.firstName;sqlText)')) >= 75
		AND UTL_MATCH.JARO_WINKLER_SIMILARITY(UPPER(sc.last_name), UPPER('~(gpv.lastName;sqlText)')) >= 90
		AND (sc.schoolid = ~(gpv.curSchoolID;num) OR ~(gpv.curSchoolID;num) = 0)
		AND (sc.calendar_year = ~(gpv.calendarYear;num) OR ~(gpv.calendarYear;num) = 0)
		AND ('~(gpv.changeType;sqlText)' = 'allStaff' OR sc.change_type = '~(gpv.changeType;sqlText)')
;]~(data)[/tlist_sql]
